    },
    {
      "parameters": {
        "jsCode": "// Input: prev.data contains the base64 image (no data URL prefix)\nconst prev = $input.first().json;\nconst base64Image = prev.data;\nif (!base64Image) {\n  throw new Error(\"No base64 image found at json.data\");\n}\n\nconst prompt = `\nYou are given a photo of a list of measurements (sometimes messy).analyse and Extract ONLY the board/panel measurements and quantities, and output EXACTLY: Length x Width = Quantity. If you find any edging in the image for example 1 Long 1 short 2 long 2 short or L1 L2 S1 S2 please add these after Quantity as L1,L2,W1,W2 with \"W\" representing short or \"S\". so example Length x Width = Quantity L1,L2,W1,W2. for edging you may not get all sides so keep it as what you find example L1,W1. sometimes there will be an hds header with company details just ignore that. you may also get other information like thickness just ignore that and give me back what you believe is Length x Width = Quantity and any edging if available. sometimes the quantity or edging may be before the Length x width.\n`.trim();\n\nreturn [\n  {\n    json: {\n      // This is the exact Gemini REST request body\n      contents: [\n        {\n          role: \"user\",\n          parts: [\n            { text: prompt },\n            {\n              inline_data: {\n                mime_type: \"image/jpeg\",   // change to image/png if needed\n                data: base64Image\n              }\n            }\n          ]\n        }\n      ]\n    }\n  }\n];"
      },
