# SendGrid Configuration (Recommended Alternative to Gmail)
# Copy these values to your .env file

# SendGrid Setup
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key-here
FROM_EMAIL=sifosman@gmail.com
FROM_NAME=HDS Group

# Supabase Configuration (replace with your actual values)
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# PayFast Sandbox Configuration
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=test123
PAYFAST_SANDBOX=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Quick SendGrid Setup Steps:
# 1. Go to https://sendgrid.com and sign up for free account
# 2. Go to Settings → API Keys → Create API Key
# 3. Copy the API key and replace "your-sendgrid-api-key-here"
# 4. Use "apikey" as SMTP_USER (literally the word "apikey")
# 5. Restart your server

# Testing Commands:
# curl http://localhost:3000/api/email/test-email-connection
# curl http://localhost:3000/api/email-hardcoded/quick-test
