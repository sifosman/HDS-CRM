{
  "id": "PR-008",
  "name": "Payment method inquiry",
  "category": "production_readiness",
  "description": "Customer asks about payment methods after receiving a quote.",
  "phone_number": "27900000547",
  "sender_name": "Naledi",
  "messages": [
    {
      "text": "Hi, I need 8 sheets of 16mm white melamine chipboard. Can you give me a quote?",
      "delay_ms": 0
    },
    {
      "text": "Do you take card payment or just EFT?",
      "delay_ms": 10000
    }
  ],
  "expected_tools": [
    "generate_quote"
  ],
  "expected_behaviors": [
    {
      "type": "contains_any_keyword",
      "keywords": [
        "card",
        "eft",
        "pay",
        "payment",
        "payfast",
        "online"
      ],
      "description": "AI should explain payment options"
    },
    {
      "type": "response_time",
      "max_ms": 45000
    }
  ],
  "forbidden_patterns": [
    {
      "pattern": "\\{.*\\}",
      "flags": "s",
      "description": "No raw JSON in reply"
    },
    {
      "pattern": "function\\(|=>|const\\s+\\w+\\s*=|let\\s+\\w+\\s*=|var\\s+\\w+\\s*=",
      "description": "No JavaScript code in reply"
    },
    {
      "pattern": "Calling (lookup_price|generate_quote|get_branch|get_banking|handover|show_products|send_payment_link)",
      "description": "No tool call debug text in reply"
    },
    {
      "pattern": "\\[CLOSE_ATTEMPT|\\[OBJECTION_HANDLED|\\[FUNNEL",
      "description": "Internal tags should be stripped from customer-facing message"
    }
  ],
  "expected_tags": [],
  "notes": "Payment options question. AI should offer PayFast link or EFT."
}