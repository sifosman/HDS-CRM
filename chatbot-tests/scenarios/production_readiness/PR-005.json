      "description": "Reply should contain total price"
    },
    {
      "type": "contains_any_keyword",
      "keywords": [
        "centurion",
        "sunderland",
        "branch"
      ],
      "description": "AI should mention nearest branch"
    },
    {
      "type": "close_attempt",
